{
  "name": "api-kickstart-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=api-kickstart && npm run build --workspaces --if-present",
    "typecheck": "npm run build --workspace=api-kickstart && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint packages/*/src examples/*/src",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.5.0",
    "eslint": "^9.39.5",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.9"
  }
}
